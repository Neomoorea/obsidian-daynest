{
  "name": "daynest",
  "version": "1.0.0",
  "description": "A modern calendar, nested entirely in your Daily Notes' Markdown.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
